<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".activity.SandwichActivity">

    <!-- Left side: controls -->
    <LinearLayout
        android:id="@+id/leftPanelSandwich"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightPanelSandwich"
        android:layout_marginEnd="16dp">

        <!-- Bread -->
        <TextView
            android:id="@+id/breadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sandwich_bread_label"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/breadSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Protein -->
        <TextView
            android:id="@+id/proteinLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sandwich_protein_label"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/proteinSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Add-ons -->
        <TextView
            android:id="@+id/addOnsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sandwich_addons_label"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/addOnsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            tools:listitem="@android:layout/simple_list_item_multiple_choice" />

        <!-- Quantity -->
        <TextView
            android:id="@+id/quantityLabelSandwich"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/quantity_label"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/decrementQtyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/quantityText"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="1"
                android:textSize="18sp" />

            <Button
                android:id="@+id/incrementQtyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Price + Add button -->
        <TextView
            android:id="@+id/priceTitleLabelSandwich"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/price_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/priceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="18sp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/addSandwichButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/add_to_order" />
    </LinearLayout>

    <!-- Right side: sandwich image -->
    <LinearLayout
        android:id="@+id/rightPanelSandwich"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftPanelSandwich">

        <TextView
            android:id="@+id/sandwichPreviewLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sandwich_preview_label"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/sandwichImage"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/sandwich_preview_label"
            android:src="@drawable/sandwich"
            tools:src="@drawable/sandwich" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>