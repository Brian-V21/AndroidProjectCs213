<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Vertical stack of buttons -->
    <LinearLayout
        android:id="@+id/menuButtonsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/donutsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_donuts"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/coffeeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_coffee"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/sandwichBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_sandwich"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <Button
            android:id="@+id/currentOrderBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_current_order"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/allOrdersBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_all_orders"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>